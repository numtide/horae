  "query": "SELECT id, name, currency, active, CASE WHEN $4 THEN default_rate_cents END as default_rate_cents\n         FROM clients\n         WHERE org_id = $1 AND strpos(lower(name), lower($2)) > 0\n         ORDER BY active DESC, lower(name), id LIMIT 51 OFFSET $3",
