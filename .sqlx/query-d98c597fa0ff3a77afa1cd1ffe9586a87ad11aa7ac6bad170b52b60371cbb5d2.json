{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.name, t.active, t.billable_default,\n                CASE WHEN access.can_view_rates THEN t.default_rate_cents END AS default_rate_cents\n         FROM tasks t JOIN task_read_access access ON access.task_id = t.id AND access.org_id = t.org_id\n         WHERE t.id = $1 AND t.org_id = $2 AND access.user_id = $3",
