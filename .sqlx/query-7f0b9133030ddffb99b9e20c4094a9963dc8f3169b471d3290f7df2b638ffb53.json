{
  "db_name": "PostgreSQL",
  "query": "SELECT pt.task_id, pt.billable, pt.rate_cents, s.restricted as \"restricted?\", s.budget_minutes, s.budget_cents\n         FROM project_tasks pt JOIN tasks t ON t.id = pt.task_id AND t.org_id = $2\n         LEFT JOIN project_task_settings s ON s.project_id = pt.project_id AND s.task_id = pt.task_id AND s.org_id = $2\n         WHERE pt.project_id = $1 ORDER BY pt.task_id",
