{
  "db_name": "PostgreSQL",
  "query": "SELECT u.id, u.name, u.active, u.billable_rate_cents,\n           CASE WHEN $3 THEN u.cost_rate_cents END as cost_rate_cents\n         FROM users u JOIN assignments a ON a.user_id = u.id\n         WHERE a.project_id = $1 AND u.org_id = $2 ORDER BY u.id",
