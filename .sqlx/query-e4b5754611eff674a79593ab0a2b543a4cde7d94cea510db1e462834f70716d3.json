{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id, g.user_id, g.scopes, c.redirect_uri, c.code_challenge,\n                  c.code_sha256, c.expires_at <= now() + interval '60 seconds' AS \"short!\"\n           FROM oauth_grants g JOIN oauth_codes c ON c.grant_id = g.id\n           WHERE g.client_id = $1",
